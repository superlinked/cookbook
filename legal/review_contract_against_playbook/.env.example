# Copy to .env and fill in.
# SIE Serverless: create a key at https://console.superlinked.com/console/keys
SIE_API_KEY=
# SIE Cluster or SIE Local: set its URL, e.g. http://localhost:8080 (see SELF_HOSTING.md at the repo root).
# Leave it empty for SIE Serverless. SIE_API_KEY is optional for a server without auth.
SIE_BASE_URL=
# agent.py only: Claude runs the agent's loop (uv run --group agent agent.py).
ANTHROPIC_API_KEY=
