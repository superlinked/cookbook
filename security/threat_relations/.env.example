# Copy to .env and fill in.
# SIE Cloud: create a key at https://console.superlinked.com/console/api-keys
SIE_API_KEY=
# Your own SIE: set its URL, e.g. http://localhost:8080 (see SELF_HOSTING.md at the repo root).
# Leave it empty for SIE Cloud. SIE_API_KEY is optional for a server without auth.
SIE_BASE_URL=
